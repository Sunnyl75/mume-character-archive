+
+/** Add the Deck to a configured primary menu unless its destination is present. */
+function bree_legends_deck_menu_link(string $items, $args): string {
+    if (($args->theme_location ?? '') !== 'primary') {
+        return $items;
+    }
+    $menu = wp_get_nav_menu_object($args->menu);
+    if (!$menu) {
+        return $items;
+    }
+    foreach (wp_get_nav_menu_items($menu->term_id) ?: array() as $item) {
+        $path = wp_parse_url($item->url, PHP_URL_PATH);
+        $host = wp_parse_url($item->url, PHP_URL_HOST);
+        if ((!$host || $host === wp_parse_url(home_url('/'), PHP_URL_HOST))
+            && untrailingslashit((string) $path) === untrailingslashit((string) wp_parse_url(home_url('/deck-of-chars/'), PHP_URL_PATH))) {
+            return $items;
+        }
+    }
+    return $items . '<li class="menu-item menu-item-deck"><a href="'
+        . esc_url(home_url('/deck-of-chars/')) . '">'
+        . esc_html__('Deck of Chars', 'bree-legends') . '</a></li>';
+}
+add_filter('wp_nav_menu_items', 'bree_legends_deck_menu_link', 10, 2);
 
